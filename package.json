{
  "name": "relaychief-control",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Optional control-plane add-on for Relay Chief",
  "bin": {
    "relaychief-control": "./dist/server.js",
    "relaychief-control-migrate": "./dist/migrate-cli.js"
  },
  "files": ["dist", "migrations", "README.md", "LICENSE"],
  "scripts": {
